DEFINE  F50T
BEGIN
   TP = 587
   TI = 2
   TN = 275
   TV = <<"SELECT TB_TITULAR, TB_NRO_TRANSFER, TB_IMPORTE, TB_CLAVE
  FROM ADRE.FIN_TRANSFER_BANCARIAS,
       ADRE.FIN_TRANSFER_BANCARIAS_DET
 WHERE TB_CLAVE = TBD_CLAVE(+)
   AND TB_CLIENTE = :BDOC.S_CUENTA
   AND TB_ESTADO <> 'REC'
 GROUP BY TB_TITULAR, TB_NRO_TRANSFER, TB_IMPORTE, TB_CLAVE
HAVING TB_IMPORTE > SUM(NVL(TBD_IMP_MON, 0))">>
END

